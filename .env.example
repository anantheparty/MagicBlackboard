# Magic Blackboard Foundation requires no API keys or other secrets.
# Values prefixed with VITE_ are bundled into client code and are public.

# Development console policy: development builds enable it by default;
# production builds require the explicit value "1" to enable it.
VITE_ENABLE_DEV_CONSOLE=0

# Future hosted-model credentials must be stored in a server-side secret manager.
# Never add provider API keys, tokens, passwords, or private endpoints to this file.
